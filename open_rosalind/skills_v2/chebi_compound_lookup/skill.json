{
  "name": "chebi_compound_lookup",
  "display_name": "ChEBI Compound Lookup",
  "description": "Resolve a ChEBI compound and summarize its definition, synonyms, and ontology relation counts.",
  "category": "chemistry",
  "version": "1.0.0",
  "evidence_schema": {
    "source": "ChEBI",
    "url": "https://www.ebi.ac.uk/chebi/"
  },
  "deterministic": true,
  "requires_network": true,
  "local_available": false,
  "safety_level": "network",
  "dependencies": ["requests"],
  "tools_used": ["chebi.search_compounds", "chebi.fetch_compound"],
  "input_schema": {
    "type": "object",
    "properties": {
      "query": {"type": "string"},
      "chebi_id": {"type": "string"},
      "max_results": {"type": "integer", "minimum": 1, "maximum": 10, "default": 5}
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "annotation": {"type": "object"},
      "confidence": {"type": "number"},
      "notes": {"type": "array"},
      "search": {"type": "object"},
      "chebi": {"type": "object"}
    }
  },
  "examples": [
    {
      "input": {"query": "caffeine"},
      "expects": "ChEBI compound summary for caffeine"
    }
  ],
  "mcp_compatible": true,
  "author": "Open-Rosalind",
  "license": "MIT"
}
