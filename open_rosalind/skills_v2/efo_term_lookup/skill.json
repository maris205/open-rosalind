{
  "name": "efo_term_lookup",
  "display_name": "EFO Term Lookup",
  "description": "Resolve an EFO or ontology term and summarize the term record from OLS4.",
  "category": "ontology",
  "version": "1.0.0",
  "evidence_schema": {
    "source": "EFO / OLS4",
    "url": "https://www.ebi.ac.uk/ols4/api"
  },
  "deterministic": true,
  "requires_network": true,
  "local_available": false,
  "safety_level": "network",
  "dependencies": ["requests"],
  "tools_used": ["efo.search_terms", "efo.fetch_term"],
  "input_schema": {
    "type": "object",
    "properties": {
      "query": {"type": "string"},
      "term_id": {"type": "string"},
      "iri": {"type": "string"},
      "max_results": {"type": "integer", "minimum": 1, "maximum": 10, "default": 5}
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "annotation": {"type": "object"},
      "confidence": {"type": "number"},
      "notes": {"type": "array"},
      "search": {"type": "object"},
      "efo": {"type": "object"}
    }
  },
  "examples": [
    {
      "input": {"query": "asthma"},
      "expects": "EFO term summary for asthma"
    }
  ],
  "mcp_compatible": true,
  "author": "Open-Rosalind",
  "license": "MIT"
}
