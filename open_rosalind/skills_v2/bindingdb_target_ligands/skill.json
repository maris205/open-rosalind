{
  "name": "bindingdb_target_ligands",
  "display_name": "BindingDB Target Ligands",
  "description": "Lookup BindingDB ligand evidence for a UniProt accession or PDB ID and summarize the top affinities.",
  "category": "chemistry",
  "version": "1.0.0",
  "evidence_schema": {
    "source": "BindingDB",
    "url": "https://bindingdb.org/"
  },
  "deterministic": true,
  "requires_network": true,
  "local_available": false,
  "safety_level": "network",
  "dependencies": ["requests"],
  "tools_used": ["bindingdb.lookup_ligands"],
  "input_schema": {
    "type": "object",
    "properties": {
      "uniprot_id": {"type": "string"},
      "pdb_id": {"type": "string"},
      "max_results": {"type": "integer", "minimum": 1, "maximum": 10, "default": 5}
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "annotation": {"type": "object"},
      "confidence": {"type": "number"},
      "notes": {"type": "array"},
      "bindingdb": {"type": "object"}
    }
  },
  "examples": [
    {
      "input": {"uniprot_id": "P04637"},
      "expects": "BindingDB affinity summary for TP53"
    }
  ],
  "mcp_compatible": true,
  "author": "Open-Rosalind",
  "license": "MIT"
}
