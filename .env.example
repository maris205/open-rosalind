# OpenAI default configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6

# Optional OpenAI-compatible fallback, for example DashScope / Qwen
DASHSCOPE_API_KEY=your_dashscope_api_key
QWEN_BASE_URL=https://llm-jl24o09ebj303z4e.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-max

# Local database and authentication
DATABASE_URL=sqlite:////root/rosalind/data/rosalind.db
ROSALIND_SESSION_DAYS=14
# Set to 1 only when the site is served through HTTPS.
ROSALIND_COOKIE_SECURE=0

# Controlled Docker execution
ROSALIND_EXECUTION_ENABLED=1
ROSALIND_PYTHON_IMAGE=python:3.12-slim
ROSALIND_EXECUTION_TIMEOUT=60
ROSALIND_EXECUTION_MEMORY=512m
ROSALIND_EXECUTION_CPUS=1
ROSALIND_EXECUTION_CONCURRENCY=2
ROSALIND_JOBS_DIR=/root/rosalind/exports/jobs

# Background task queue
REDIS_URL=redis://127.0.0.1:6379/0
ROSALIND_QUEUE=rosalind
