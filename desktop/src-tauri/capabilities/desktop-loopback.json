{
  "$schema": "../gen/schemas/remote-schema.json",
  "identifier": "desktop-loopback",
  "description": "Minimal Desktop Core IPC for the authenticated loopback UI",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:event:default",
    "dialog:allow-confirm",
    "allow-desktop-core-status",
    "allow-desktop-create-conversation",
    "allow-desktop-list-conversations",
    "allow-desktop-load-ui-chat-state",
    "allow-desktop-replace-ui-chat-state",
    "allow-desktop-create-agent-job",
    "allow-desktop-list-agent-jobs",
    "allow-desktop-get-project-directory-authorization",
    "allow-desktop-authorize-project-directory",
    "allow-desktop-reveal-project-directory",
    "allow-desktop-revoke-project-directory",
    "allow-desktop-get-agent-job",
    "allow-desktop-start-agent-job",
    "allow-desktop-refresh-agent-job",
    "allow-desktop-cancel-agent-job",
    "allow-desktop-credential-vault-status",
    "allow-desktop-list-provider-profiles",
    "allow-desktop-save-provider-profile",
    "allow-desktop-clear-provider-credential",
    "allow-desktop-stream-provider-chat",
    "allow-desktop-cancel-provider-chat",
    "allow-desktop-list-tool-contracts",
    "allow-desktop-container-capability",
    "allow-desktop-prepare-container-image",
    "allow-desktop-run-low-risk-tool",
    "allow-desktop-list-tool-runs",
    "allow-desktop-propose-tool-run",
    "allow-desktop-decide-tool-run",
    "allow-desktop-execute-approved-python-tool",
    "allow-desktop-execute-approved-container-tool",
    "allow-desktop-cancel-tool-run",
    "allow-desktop-list-tool-artifacts",
    "allow-desktop-read-tool-artifact",
    "allow-desktop-reveal-tool-artifact",
    "allow-desktop-export-tool-artifact"
  ]
}
